# NeuroAid Backend — Environment Variables Template
# Copy to .env and adjust for deployment. Do not commit actual .env with secrets.

# ── Server & Environment ──────────────────────────────────────────────────────
APP_NAME=NeuroAid API
APP_VERSION=2.0.0
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Security & Sessions ───────────────────────────────────────────────────────
# Absolute session expiration in seconds (default: 8 hours = 28800)
SESSION_TTL_SECONDS=28800
# Inactivity / idle session timeout in seconds (default: 1 hour = 3600)
SESSION_IDLE_TIMEOUT_SECONDS=3600
# Maximum failed consecutive login attempts before account/IP lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout cooldown period in seconds (default: 15 minutes = 900)
LOCKOUT_DURATION_SECONDS=900
# Security and PHI access audit logging
AUDIT_LOG_ENABLED=true

# ── CORS (Never use '*' when credentials are true) ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── AI Service Integration ────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=15.0

# ── Composite risk score weights (must sum to 1.0) ────────────────────────────
MEMORY_WEIGHT=0.30
SPEECH_WEIGHT=0.25
EXECUTIVE_WEIGHT=0.20
REACTION_WEIGHT=0.15
MOTOR_WEIGHT=0.10

# ── Risk thresholds (0–100) ───────────────────────────────────────────────────
THRESHOLD_MILD=50
THRESHOLD_MODERATE=70
THRESHOLD_HIGH=85
